# ========================================================
# PromptCraft AI – Prompt Engineering Tutor Configuration
# ========================================================

# Server listening port
PORT=5000

# AI Provider Selection
# Options: 'openai' | 'gemini' | 'groq' | 'openrouter' | 'ollama' | 'anthropic' | 'custom'
AI_PROVIDER=openai

# Primary API Key for your provider (leave empty for unconfigured status check)
# e.g., sk-proj-... (OpenAI) or AIzaSy... (Gemini) or gsk_... (Groq)
AI_API_KEY=

# Model Name
# OpenAI default: gpt-4o-mini
# Gemini default: gemini-1.5-flash
# Groq default: llama-3.3-70b-versatile
# OpenRouter default: meta-llama/llama-3.3-70b-instruct
AI_MODEL=gpt-4o-mini

# Optional: Custom Base URL for OpenAI-compatible proxies, LM Studio, or Ollama
# AI_BASE_URL=http://localhost:11434/v1
